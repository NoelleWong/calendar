// Prisma schema — Calendar Comparison App
// See CLAUDE.md for the full data model rationale and conventions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (NextAuth.js — OAuth). Standard NextAuth Prisma adapter shape.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]

  projectGroups    ProjectGroup[]
  projects         Project[]
  calendarBlocks   CalendarBlock[]
  calendarWeeks    CalendarWeek[]
  templates        Template[]
  rotations        TemplateRotation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain model
// ---------------------------------------------------------------------------

// The "color" level. Every bubble's fill color is resolved through
// Project -> ProjectGroup.color — never stored directly on Project or
// CalendarBlock. See CLAUDE.md "Rule: a block's color is always derived...".
model ProjectGroup {
  id     String @id @default(cuid())
  userId String
  name   String
  color  String // hex, e.g. "#4F46E5"

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

// The "bubble" level. One Project = one distinct bubble identity; its color
// comes from its ProjectGroup.
model Project {
  id      String @id @default(cuid())
  userId  String
  groupId String
  name    String

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  group ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  calendarBlocks CalendarBlock[]
  templateBlocks TemplateBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([groupId])
}

// Atomic 30-min storage unit. Bubbles are computed at render time by merging
// consecutive same-project CalendarBlocks within a day — never persisted.
// See CLAUDE.md "Rule: bubbles are a display-layer merge, never stored."
model CalendarBlock {
  id          String      @id @default(cuid())
  userId      String
  projectId   String
  weekId      String      // ISO week, e.g. "2026-W29" (Monday-start)
  dayOfWeek   Int         // 0 (Mon) – 6 (Sun)
  slotIndex   Int         // 0–47, 30-min increments from midnight
  createdFrom CreatedFrom @default(MANUAL)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One project occupies at most one slot per day per week — prevents
  // overlapping blocks and keeps the bubble-merge scan well-defined.
  @@unique([userId, weekId, dayOfWeek, slotIndex])
  @@index([userId, weekId])
  @@index([projectId])
}

// Marks a week as already filled, so it is auto-filled at most once — even
// if every block is later cleared, the week stays empty rather than being
// re-copied from a template. templateId records the template the week was
// last filled from (by the rotation/default, or via "Apply template"), for
// display only; editing the week never touches the template.
model CalendarWeek {
  id         String  @id @default(cuid())
  userId     String
  weekId     String // ISO week, e.g. "2026-W29"
  templateId String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekId])
  @@index([templateId])
}

enum CreatedFrom {
  TEMPLATE
  MANUAL
}

// A user's reusable default week. TemplateBlocks are copied into real
// CalendarBlock rows (createdFrom: TEMPLATE) when a fresh week is opened —
// never referenced live. See CLAUDE.md "Templates are read-only at
// instantiation time."
model Template {
  id        String  @id @default(cuid())
  userId    String
  name      String
  isDefault Boolean @default(false)

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks          TemplateBlock[]
  rotationEntries TemplateRotationEntry[]
  calendarWeeks   CalendarWeek[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  // Enforced in application code (Postgres can't do a partial unique index
  // via Prisma syntax directly): only one Template per user may have
  // isDefault = true. Wrap default-swap in a transaction — unset the old
  // default, then set the new one.
}

model TemplateBlock {
  id         String @id @default(cuid())
  templateId String
  projectId  String
  dayOfWeek  Int    // 0 (Mon) – 6 (Sun)
  slotIndex  Int    // 0–47

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([templateId, dayOfWeek, slotIndex])
  @@index([templateId])
}

// An ordered cycle of templates that fills new weeks in turn: entry 0 fills
// startWeekId, entry 1 the week after, and so on, wrapping back to entry 0.
// The template for a week is computed from its distance to startWeekId (see
// lib/rotation.ts) rather than by advancing a "current" pointer, so it stays
// correct when weeks are opened out of order or skipped.
//
// A user can have several rotations; a week is filled from the one with the
// latest startWeekId on or before it. Switching to a new set of templates is
// therefore "create a rotation starting from week X" — earlier weeks keep
// following the old one. Weeks no rotation covers fall back to the default
// Template.
model TemplateRotation {
  id          String @id @default(cuid())
  userId      String
  name        String
  startWeekId String // ISO week, e.g. "2026-W44"; must be normalized so string order = week order

  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries TemplateRotationEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  // At most one rotation takes effect in any given week.
  @@unique([userId, startWeekId])
}

// One step of a rotation. Ordered by position (sparse positions are fine —
// deleting a template removes its entries and the rest keep their order).
// The same template may appear more than once (e.g. A, A, B).
model TemplateRotationEntry {
  id         String @id @default(cuid())
  rotationId String
  templateId String
  position   Int

  rotation TemplateRotation @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  template Template         @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([rotationId, position])
  @@index([templateId])
}
